+def _index_rows(dates=None, base=3000.0):
+    dates = dates or _SYN_DATES
+    rows = []
+    value = base
+    for d in dates:
+        value += 1.0
+        rows.append({"date8": d, "open": round(value, 3),
+                     "close": round(value + 5.0, 3),
+                     "high": round(value + 6.0, 3),
+                     "low": round(value - 1.0, 3)})
+    return rows
