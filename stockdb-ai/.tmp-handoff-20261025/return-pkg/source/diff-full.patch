+class CompatAndIsolationTest(ResearchTestCase):
+    def test_legacy_requests_still_return_none_from_dispatch(self):
+        # S05：无 contract_version 的请求不经 v3 分支
+        self.assertIsNone(v3.maybe_dispatch("get_adjust_factors",
