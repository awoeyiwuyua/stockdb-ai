+def _em_record(ok: bool, reason: str | None = None) -> None:
+    with _EM_STATE_LOCK:
+        if ok:
+            _EM_LAST_STATE.update(ok_at=time.time(), fail_reason=None)
+        else:
+            _EM_LAST_STATE.update(fail_at=time.time(), fail_reason=reason)
